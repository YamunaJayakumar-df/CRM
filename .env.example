# Environment variable template (safe to commit: contains NO real values).
#
# How to use:
#   1. Copy this file to .env.local
#   2. Uncomment the lines you need and fill in the real values there.
#   .env.local is ignored by git, so real secrets never get committed.
#
# IMPORTANT: server secrets (database URLs, API keys) must NEVER use the
# NEXT_PUBLIC_ prefix. Next.js copies NEXT_PUBLIC_* variables into the
# browser code, where anyone can read them.

# Database connection string (Supabase Postgres) - added in a later step.
# DATABASE_URL=

# Claude API key for the AI assistant - added in a later step.
# ANTHROPIC_API_KEY=
