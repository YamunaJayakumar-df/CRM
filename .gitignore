# Root .gitignore for the whole repo (frontend/ and backend/).
# Patterns without a leading "/" match in every subfolder,
# e.g. "node_modules/" ignores frontend/node_modules and backend/node_modules.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# build output
# (.next/ and out/ come from Next.js in frontend/,
#  dist/ comes from the TypeScript compiler in backend/)
.next/
out/
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real secrets live in .env, .env.local, etc. and must never
# be committed. Only the empty .env.example templates are shared.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
