// Prisma schema: describes our database tables ("models").
// Docs: https://pris.ly/d/prisma-schema
// The database connection URL is set in prisma.config.ts (read from backend/.env).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A company we provide IT services to.
model Customer {
  id          Int      @id @default(autoincrement())
  companyName String
  contactName String?
  email       String?
  phone       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interactions Interaction[]
}

// The kinds of contact we log with a customer.
enum InteractionType {
  CALL
  EMAIL
  MEETING
  NOTE
}

// Something that happened with a customer (a call, an email, a meeting, a note).
model Interaction {
  id         Int             @id @default(autoincrement())
  // Restrict: the database refuses to delete a customer that still has interactions.
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerId Int
  type       InteractionType
  summary    String
  occurredAt DateTime
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  // Speeds up "all interactions for this customer".
  @@index([customerId])
}
