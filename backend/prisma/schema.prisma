// Prisma schema: describes our database tables ("models").
// Docs: https://pris.ly/d/prisma-schema
// The database connection URL is set in prisma.config.ts (read from backend/.env).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A company we provide IT services to.
model Customer {
  id          Int      @id @default(autoincrement())
  companyName String
  contactName String?
  email       String?
  phone       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
