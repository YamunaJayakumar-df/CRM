# Backend environment template (safe to commit: contains NO real values).
#
# How to use:
#   1. Copy this file to backend/.env (ignored by git).
#   2. Uncomment the lines you need and fill in the real values there.
#
# The backend is where SERVER SECRETS live (database URL, API keys).
# Real secrets go only in backend/.env - never in frontend/ and never in git.

# Port the API server listens on (default 4000 if not set).
# PORT=4000

# Database (Supabase Postgres). Both values come from the Supabase dashboard
# ("Connect" button). They contain the database PASSWORD: secrets.
#   DATABASE_URL  the POOLED connection, used by the running app (src/db.ts)
#   DIRECT_URL    the DIRECT / session connection, used only by Prisma
#                 commands such as migrations (prisma.config.ts)
# DATABASE_URL=
# DIRECT_URL=

# Azure OpenAI (the AI assistant's "brain"). Values come from the team's
# Azure portal. The key is a SECRET: only in backend/.env, never in git,
# never in frontend/, never pasted into chats.
#   ENDPOINT    our Azure OpenAI address, must start with https://
#   API_VERSION Azure OpenAI API version, e.g. 2024-10-21
#   DEPLOYMENT_REASONING  deployment name of the smarter model (details, actions)
#   DEPLOYMENT_ROUTING    deployment name of the faster model (what kind of request)
# Check them with: npm run ai:hello
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=
# AZURE_OPENAI_DEPLOYMENT_REASONING=
# AZURE_OPENAI_DEPLOYMENT_ROUTING=
