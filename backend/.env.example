# Backend environment template (safe to commit: contains NO real values).
#
# How to use:
#   1. Copy this file to backend/.env (ignored by git).
#   2. Uncomment the lines you need and fill in the real values there.
#
# The backend is where SERVER SECRETS live (database URL, API keys).
# Real secrets go only in backend/.env - never in frontend/ and never in git.

# Port the API server listens on (default 4000 if not set).
# PORT=4000

# Database connection string (Supabase Postgres) - added in a later step.
# DATABASE_URL=

# Claude API key for the AI assistant - added in a later step.
# ANTHROPIC_API_KEY=
